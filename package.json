{
  "name": "supplysense",
  "version": "0.1.0",
  "private": true,
  "description": "SupplySence multi-warehouse retail and replenishment platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server run test",
    "test:e2e": "node server/test/phase-9-12.e2e.mjs",
    "check": "npm --workspace server run check && npm --workspace server run test && npm --workspace server run db:validate && npm --workspace client run build",
    "verify:local": "npm run check && npm run db:status && npm run db:local:status && node scripts/verify-local.mjs",
    "db:generate": "npm --workspace server run db:generate",
    "db:migrate": "npm --workspace server run db:migrate",
    "db:deploy": "npm --workspace server run db:deploy",
    "db:status": "npm --workspace server run db:status",
    "db:seed": "npm --workspace server run db:seed",
    "db:local:init": "bash scripts/local-postgres.sh init",
    "db:local:start": "bash scripts/local-postgres.sh start",
    "db:local:stop": "bash scripts/local-postgres.sh stop",
    "db:local:status": "bash scripts/local-postgres.sh status",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
