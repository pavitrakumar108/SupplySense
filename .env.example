NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://supplysense:supplysense@localhost:5433/supplysense?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-development-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-development-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
RESERVATION_TTL_SECONDS=900
MOCK_PAYMENT_WEBHOOK_SECRET=replace-with-a-long-local-payment-webhook-secret-at-least-32-characters
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SEED_ADMIN_PASSWORD=ChangeMe!12345
SEED_CUSTOMER_PASSWORD=Customer!12345
SEED_MANAGER_PASSWORD=Manager!12345
SEED_AUDITOR_PASSWORD=Auditor!12345
SEED_SUPPLIER_PASSWORD=Supplier!12345
