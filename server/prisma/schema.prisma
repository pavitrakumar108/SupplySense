generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoleCode {
  CUSTOMER
  SUPPLIER
  WAREHOUSE_MANAGER
  ADMIN
  AUDITOR
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RESERVATION
  RELEASE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  DAMAGE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum CheckoutPaymentMethod {
  UPI
  CARD
  COD
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  REJECTED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum RecommendationStatus {
  PENDING
  APPROVED
  REJECTED
  INSUFFICIENT_HISTORY
}

enum RecommendationPriority {
  CRITICAL
  HIGH
  NORMAL
  NONE
}

enum AnomalyDirection {
  SPIKE
  DROP
}

model User {
  id                    String              @id @default(uuid()) @db.Uuid
  email                 String              @unique @db.VarChar(320)
  passwordHash          String?             @map("password_hash")
  googleSub             String?             @unique @map("google_sub") @db.VarChar(255)
  emailVerifiedAt       DateTime?           @default(now()) @map("email_verified_at")
  fullName              String              @map("full_name") @db.VarChar(160)
  isActive              Boolean             @default(true) @map("is_active")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  managerWarehouses     ManagerWarehouse[]
  carts                 Cart[]
  wishlists             Wishlist[]
  orders                Order[]
  addresses             Address[]
  inventoryMovements    InventoryMovement[] @relation("MovementActor")
  purchaseOrdersCreated PurchaseOrder[]     @relation("PurchaseOrderCreator")
  goodsReceipts         GoodsReceipt[]      @relation("GoodsReceiptReceiver")
  recommendationDecisions ReorderRecommendation[] @relation("RecommendationDecisionActor")
  supplierProfile       Supplier?           @relation("SupplierAccount")
  auditLogs             AuditLog[]          @relation("AuditActor")
  emailVerifications    EmailVerification[]
  feedback              CustomerFeedback[]
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  codeHash    String    @map("code_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
}

model CustomerFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  name       String   @db.VarChar(160)
  email      String   @db.VarChar(320)
  subject    String   @db.VarChar(160)
  message    String
  rating     Int?
  isResolved Boolean  @default(false) @map("is_resolved")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([isResolved, createdAt])
}

model Role {
  id        String       @id @default(uuid()) @db.Uuid
  code      UserRoleCode @unique
  name      String       @db.VarChar(80)
  createdAt DateTime     @default(now()) @map("created_at")
  users     UserRole[]
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ManagerWarehouse {
  managerId   String    @map("manager_id") @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  manager     User      @relation(fields: [managerId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([managerId, warehouseId])
  @@index([warehouseId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @map("category_id") @db.Uuid
  name        String           @db.VarChar(180)
  slug        String           @unique @db.VarChar(200)
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]

  @@index([categoryId, isActive])
}

model ProductVariant {
  id                 String                   @id @default(uuid()) @db.Uuid
  productId          String                   @map("product_id") @db.Uuid
  sku                String                   @unique @db.VarChar(80)
  barcode            String?                  @unique @db.VarChar(80)
  attributes         Json                     @default("{}")
  price              Decimal                  @db.Decimal(12, 2)
  currency           String                   @default("USD") @db.Char(3)
  isActive           Boolean                  @default(true) @map("is_active")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  reservationItems   ReservationItem[]
  supplierProducts   SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  shipmentItems      ShipmentItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  salesHistory       SalesHistoryDaily[]
  forecasts          DemandForecast[]
  anomalies          DemandAnomaly[]
  recommendations    ReorderRecommendation[]

  @@index([productId, isActive])
}

model ProductImage {
  id        String         @id @default(uuid()) @db.Uuid
  productId String         @map("product_id") @db.Uuid
  variantId String?        @map("variant_id") @db.Uuid
  imageUrl  String         @map("image_url")
  altText   String?        @map("alt_text")
  sortOrder Int            @default(0) @map("sort_order")
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model Warehouse {
  id                    String                   @id @default(uuid()) @db.Uuid
  code                  String                   @unique @db.VarChar(40)
  name                  String                   @db.VarChar(160)
  addressLine1          String                   @map("address_line1")
  city                  String                   @db.VarChar(100)
  state                 String?                  @db.VarChar(100)
  postalCode            String                   @map("postal_code") @db.VarChar(30)
  country               String                   @db.VarChar(80)
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  managers              ManagerWarehouse[]
  inventory             Inventory[]
  orders                Order[]
  inventoryMovements    InventoryMovement[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  salesHistory          SalesHistoryDaily[]
  forecasts             DemandForecast[]
  anomalies             DemandAnomaly[]
  recommendations       ReorderRecommendation[]

  @@index([isActive])
}

model Inventory {
  id                 String              @id @default(uuid()) @db.Uuid
  warehouseId        String              @map("warehouse_id") @db.Uuid
  variantId          String              @map("variant_id") @db.Uuid
  onHandQuantity     Int                 @default(0) @map("on_hand_quantity")
  reservedQuantity   Int                 @default(0) @map("reserved_quantity")
  reorderLevel       Int                 @default(0) @map("reorder_level")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  warehouse          Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant            ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  movements          InventoryMovement[]
  reservationItems   ReservationItem[]
  batches            InventoryBatch[]

  @@unique([warehouseId, variantId])
  @@index([warehouseId, updatedAt])
}

model InventoryBatch {
  id          String    @id @default(uuid()) @db.Uuid
  inventoryId String    @map("inventory_id") @db.Uuid
  batchCode   String    @map("batch_code") @db.VarChar(100)
  expiryDate  DateTime? @map("expiry_date") @db.Date
  quantity    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, batchCode])
}

model InventoryMovement {
  id            String                @id @default(uuid()) @db.Uuid
  inventoryId   String                @map("inventory_id") @db.Uuid
  warehouseId   String                @map("warehouse_id") @db.Uuid
  variantId     String                @map("variant_id") @db.Uuid
  type          InventoryMovementType
  quantity      Int
  onHandBefore  Int                   @map("on_hand_before")
  onHandAfter   Int                   @map("on_hand_after")
  reservedBefore Int                  @map("reserved_before")
  reservedAfter  Int                  @map("reserved_after")
  referenceType String?               @map("reference_type") @db.VarChar(80)
  referenceId   String?               @map("reference_id") @db.Uuid
  actorId       String?               @map("actor_id") @db.Uuid
  metadata      Json                  @default("{}")
  createdAt     DateTime              @default(now()) @map("created_at")
  inventory     Inventory             @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor         User?                 @relation("MovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([warehouseId, variantId, createdAt])
  @@index([referenceType, referenceId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  id         String         @id @default(uuid()) @db.Uuid
  wishlistId String         @map("wishlist_id") @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at")
  wishlist   Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, variantId])
}

model Address {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  label        String   @db.VarChar(80)
  recipientName String  @map("recipient_name") @db.VarChar(160)
  line1        String
  line2        String?
  city         String   @db.VarChar(100)
  state        String?  @db.VarChar(100)
  postalCode   String   @map("postal_code") @db.VarChar(30)
  country      String   @db.VarChar(80)
  phone        String?  @db.VarChar(40)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id              String              @id @default(uuid()) @db.Uuid
  customerId      String              @map("customer_id") @db.Uuid
  warehouseId     String?             @map("warehouse_id") @db.Uuid
  status          OrderStatus         @default(PENDING_PAYMENT)
  paymentMethod   CheckoutPaymentMethod @default(UPI) @map("payment_method")
  currency        String              @default("USD") @db.Char(3)
  subtotalAmount  Decimal             @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  shippingAmount  Decimal             @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  taxAmount       Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(12, 2)
  shippingAddress Json                @map("shipping_address")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  customer        User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse       Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  reservations    Reservation[]
  payments        Payment[]

  @@index([customerId, createdAt])
  @@index([warehouseId, status, createdAt])
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  skuSnapshot    String         @map("sku_snapshot") @db.VarChar(80)
  productNameSnapshot String    @map("product_name_snapshot") @db.VarChar(180)
  unitPrice      Decimal        @map("unit_price") @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal        @map("line_total") @db.Decimal(12, 2)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now()) @map("created_at")
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  status      ReservationStatus @default(PENDING)
  expiresAt   DateTime          @map("expires_at")
  confirmedAt DateTime?         @map("confirmed_at")
  releasedAt  DateTime?         @map("released_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items       ReservationItem[]

  @@index([status, expiresAt])
  @@index([orderId])
}

model ReservationItem {
  id            String         @id @default(uuid()) @db.Uuid
  reservationId String         @map("reservation_id") @db.Uuid
  inventoryId   String         @map("inventory_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  quantity      Int
  reservation   Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  inventory     Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([inventoryId])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  status            PaymentStatus @default(PENDING)
  provider          String        @db.VarChar(60)
  providerPaymentId String?       @unique @map("provider_payment_id") @db.VarChar(160)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("USD") @db.Char(3)
  idempotencyKey    String?       @map("idempotency_key") @db.VarChar(160)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model IdempotencyKey {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String?   @map("user_id") @db.Uuid
  key            String    @db.VarChar(160)
  operation      String    @db.VarChar(100)
  requestHash    String    @map("request_hash") @db.VarChar(128)
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([userId, key, operation])
  @@index([expiresAt])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(40)
  name             String            @db.VarChar(160)
  email            String?           @db.VarChar(320)
  userId           String?           @unique @map("user_id") @db.Uuid
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User?             @relation("SupplierAccount", fields: [userId], references: [id], onDelete: SetNull)
  products         SupplierProduct[]
  purchaseOrders   PurchaseOrder[]
}

model SupplierProduct {
  id               String          @id @default(uuid()) @db.Uuid
  supplierId       String          @map("supplier_id") @db.Uuid
  variantId        String          @map("variant_id") @db.Uuid
  supplierSku      String?         @map("supplier_sku") @db.VarChar(80)
  unitCost         Decimal         @map("unit_cost") @db.Decimal(12, 2)
  currency         String          @default("USD") @db.Char(3)
  leadTimeDays     Int             @map("lead_time_days")
  minimumOrderQty  Int             @default(0) @map("minimum_order_qty")
  packSize         Int             @default(1) @map("pack_size")
  isActive         Boolean         @default(true) @map("is_active")
  supplier         Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([supplierId, variantId])
  @@index([variantId, isActive])
}

model PurchaseOrder {
  id          String             @id @default(uuid()) @db.Uuid
  orderNumber String             @unique @map("order_number") @db.VarChar(50)
  supplierId  String             @map("supplier_id") @db.Uuid
  warehouseId String             @map("warehouse_id") @db.Uuid
  createdById String             @map("created_by_id") @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  currency    String             @default("USD") @db.Char(3)
  totalAmount Decimal            @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  supplier    Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User               @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]
  shipments   Shipment[]
  receipts    GoodsReceipt[]
  recommendations ReorderRecommendation[]

  @@index([supplierId, status, createdAt])
  @@index([warehouseId, status, createdAt])
}

model PurchaseOrderItem {
  id                String          @id @default(uuid()) @db.Uuid
  purchaseOrderId   String          @map("purchase_order_id") @db.Uuid
  supplierProductId String          @map("supplier_product_id") @db.Uuid
  variantId         String          @map("variant_id") @db.Uuid
  quantityOrdered   Int             @map("quantity_ordered")
  quantityReceived  Int             @default(0) @map("quantity_received")
  unitCost          Decimal         @map("unit_cost") @db.Decimal(12, 2)
  lineTotal         Decimal         @map("line_total") @db.Decimal(12, 2)
  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplierProduct   SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Restrict)
  variant           ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptItems      GoodsReceiptItem[]
  shipmentItems     ShipmentItem[]

  @@index([purchaseOrderId])
}

model Shipment {
  id              String            @id @default(uuid()) @db.Uuid
  purchaseOrderId String            @map("purchase_order_id") @db.Uuid
  status          ShipmentStatus    @default(PENDING)
  trackingNumber  String?           @map("tracking_number") @db.VarChar(160)
  shippedAt       DateTime?         @map("shipped_at")
  deliveredAt     DateTime?         @map("delivered_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  shipmentItems   ShipmentItem[]

  @@index([purchaseOrderId, status])
}

model ShipmentItem {
  id                String            @id @default(uuid()) @db.Uuid
  shipmentId        String            @map("shipment_id") @db.Uuid
  purchaseOrderItemId String          @map("purchase_order_item_id") @db.Uuid
  variantId         String            @map("variant_id") @db.Uuid
  quantityShipped   Int               @map("quantity_shipped")
  shipment          Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([shipmentId])
  @@index([purchaseOrderItemId])
}

model GoodsReceipt {
  id              String             @id @default(uuid()) @db.Uuid
  purchaseOrderId String             @map("purchase_order_id") @db.Uuid
  warehouseId     String             @map("warehouse_id") @db.Uuid
  receivedById    String             @map("received_by_id") @db.Uuid
  receivedAt      DateTime           @default(now()) @map("received_at")
  notes           String?
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy      User               @relation("GoodsReceiptReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  items           GoodsReceiptItem[]

  @@index([purchaseOrderId, receivedAt])
  @@index([warehouseId, receivedAt])
}

model GoodsReceiptItem {
  id                String            @id @default(uuid()) @db.Uuid
  goodsReceiptId    String            @map("goods_receipt_id") @db.Uuid
  purchaseOrderItemId String          @map("purchase_order_item_id") @db.Uuid
  variantId         String            @map("variant_id") @db.Uuid
  quantityReceived  Int               @map("quantity_received")
  batchCode         String?           @map("batch_code") @db.VarChar(100)
  expiryDate        DateTime?         @map("expiry_date") @db.Date
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
}

model SalesHistoryDaily {
  id            String         @id @default(uuid()) @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  warehouseId   String         @map("warehouse_id") @db.Uuid
  businessDate  DateTime       @map("business_date") @db.Date
  unitsSold     Int            @map("units_sold")
  revenue       Decimal        @db.Decimal(12, 2)
  stockoutFlag  Boolean        @default(false) @map("stockout_flag")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId, businessDate])
  @@index([variantId, warehouseId, businessDate])
}

model DemandForecast {
  id                   String         @id @default(uuid()) @db.Uuid
  variantId            String         @map("variant_id") @db.Uuid
  warehouseId          String         @map("warehouse_id") @db.Uuid
  horizonDays          Int            @map("horizon_days")
  forecastStart        DateTime       @map("forecast_start") @db.Date
  forecastDailyDemand  Decimal        @map("forecast_daily_demand") @db.Decimal(12, 4)
  predictedTotal       Decimal        @map("predicted_total") @db.Decimal(12, 2)
  formulaVersion       String         @map("formula_version") @db.VarChar(40)
  inputs               Json           @default("{}")
  createdAt            DateTime       @default(now()) @map("created_at")
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse            Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([variantId, warehouseId, forecastStart])
}

model DemandAnomaly {
  id                      String          @id @default(uuid()) @db.Uuid
  variantId               String          @map("variant_id") @db.Uuid
  warehouseId             String          @map("warehouse_id") @db.Uuid
  businessDate            DateTime        @map("business_date") @db.Date
  actualSales             Int             @map("actual_sales")
  expectedSales           Decimal         @map("expected_sales") @db.Decimal(12, 4)
  rollingStandardDeviation Decimal        @map("rolling_standard_deviation") @db.Decimal(12, 4)
  zScore                  Decimal         @map("z_score") @db.Decimal(12, 4)
  direction               AnomalyDirection
  createdAt               DateTime        @default(now()) @map("created_at")
  variant                 ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse               Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([variantId, warehouseId, businessDate])
  @@index([warehouseId, businessDate])
}

model ReorderRecommendation {
  id                    String                   @id @default(uuid()) @db.Uuid
  variantId             String                   @map("variant_id") @db.Uuid
  warehouseId           String                   @map("warehouse_id") @db.Uuid
  purchaseOrderId       String?                  @map("purchase_order_id") @db.Uuid
  status                RecommendationStatus    @default(PENDING)
  priority              RecommendationPriority
  forecastDailyDemand   Decimal                  @map("forecast_daily_demand") @db.Decimal(12, 4)
  leadTimeDays          Int                      @map("lead_time_days")
  leadTimeDemand        Decimal                  @map("lead_time_demand") @db.Decimal(12, 2)
  safetyStock           Decimal                  @map("safety_stock") @db.Decimal(12, 2)
  availableQuantity     Int                      @map("available_quantity")
  recommendedQuantity   Int                      @map("recommended_quantity")
  formulaVersion        String                   @map("formula_version") @db.VarChar(40)
  explanation           String
  inputs                Json                     @default("{}")
  decisionById          String?                  @map("decision_by_id") @db.Uuid
  decisionAt            DateTime?                @map("decision_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  variant               ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse             Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  purchaseOrder         PurchaseOrder?           @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  decisionBy            User?                    @relation("RecommendationDecisionActor", fields: [decisionById], references: [id], onDelete: SetNull)

  @@index([warehouseId, status, priority, createdAt])
  @@index([variantId, warehouseId, createdAt])
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String   @map("resource_type") @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.Uuid
  outcome       String   @db.VarChar(40)
  correlationId String?  @map("correlation_id") @db.VarChar(128)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
}
